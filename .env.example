# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here

# Railway environment (auto-set on Railway, for local testing)
RAILWAY_PUBLIC_DOMAIN=localhost:8080
PORT=8080

# FCPO morning brief (Mon-Fri)
# Leave ANTHROPIC_API_KEY empty for a scorecard-only brief
ANTHROPIC_API_KEY=
# Send /chatid to the bot to get this number
FCPO_BRIEF_CHAT_ID=
# HH:MM in MYT
FCPO_BRIEF_TIME=09:45
FCPO_BRIEF_MODEL=claude-opus-5-5
